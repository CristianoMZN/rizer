SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/riser_marketplaces
SPRING_DATASOURCE_USERNAME=riser
SPRING_DATASOURCE_PASSWORD=riser

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_AI_VECTORSTORE_REDIS_INDEX=riser-vector-index
SPRING_AI_VECTORSTORE_REDIS_PREFIX=riser:vector:
SPRING_AI_VECTORSTORE_REDIS_INITIALIZE_SCHEMA=true

SERVER_PORT=8080

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

APP_S3_BUCKET=rizer
APP_S3_REGION=br-se1
APP_S3_KEY_PREFIX=uploads
APP_S3_PRESIGNED_DURATION_MINUTES=15

# Endpoint customizado para Object Storage compatível S3 (ex: https://br-se1.magaluobjects.com)
APP_S3_ENDPOINT=https://br-se1.magaluobjects.com
APP_S3_PATH_STYLE=true

# Credenciais AWS opcionais (ou use profile/role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

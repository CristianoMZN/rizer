SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rizer_marketplaces
SPRING_DATASOURCE_USERNAME=rizer
SPRING_DATASOURCE_PASSWORD=rizer

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_AI_VECTORSTORE_REDIS_INDEX=rizer-vector-index
SPRING_AI_VECTORSTORE_REDIS_PREFIX=rizer:vector:
SPRING_AI_VECTORSTORE_REDIS_INITIALIZE_SCHEMA=true

SERVER_PORT=8080

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# JWT (obrigatório, mín. 32 bytes)
APP_JWT_SECRET=
APP_JWT_ACCESS_TTL_MINUTES=60
APP_JWT_REFRESH_TTL_DAYS=30
APP_JWT_ISSUER=motorise

# Para onde o OAuth2 redireciona após sucesso (frontend)
APP_OAUTH2_SUCCESS_REDIRECT=http://localhost:3000/auth/callback

APP_S3_REGION=br-se1
APP_S3_ENDPOINT=https://br-se1.magaluobjects.com
APP_S3_PATH_STYLE=true

# Bucket público (imagens de anúncios) — URL direta sem assinatura
APP_S3_PUBLIC_BUCKET=rizer-pic
APP_S3_PUBLIC_KEY_PREFIX=uploads

# Bucket privado (documentos, contratos, PDFs) — requer presigned URL
APP_S3_PRIVATE_BUCKET=rizer-storage
APP_S3_PRIVATE_KEY_PREFIX=docs
APP_S3_PRESIGNED_DURATION_MINUTES=15

# Credenciais AWS (Magalu Cloud) — use profile/role em produção
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# CepAberto (https://www.cepaberto.com/) — usado para geocoding de CEPs.
# Se vazio, o /tenant/util/cep/{cep} retorna 204 e o front assume HTML5 geolocation.
APP_CEPABERTO_TOKEN=

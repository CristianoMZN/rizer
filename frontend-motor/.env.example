# Frontend — variáveis de ambiente
# Copie para .env e preencha os valores

# URL base da API Spring Boot
VITE_API_URL=http://localhost:8080/api

# Facebook App ID para login social (opcional — vazio desativa o botão)
VITE_FACEBOOK_APP_ID=

# Domínio base da plataforma (usado para resolução de tenant por subdomínio)
VITE_BASE_DOMAIN=motorise.com.br
